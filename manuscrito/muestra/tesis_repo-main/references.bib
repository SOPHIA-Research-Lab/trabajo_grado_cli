	pages = {53},
}

@article{rojas-palomino_electrophysiological_2024,
	title = {Electrophysiological evaluation of the effect of peptide toxins on voltage-gated ion channels: a scoping review on theoretical and methodological aspects with focus on the {Central} and {South} {American} experience},
	volume = {30},
	issn = {1678-9199},
	shorttitle = {Electrophysiological evaluation of the effect of peptide toxins on voltage-gated ion channels},
	url = {https://www.scielo.br/j/jvatitd/a/6BWMP6cVpJw7vsPKjwWqcKC/?lang=en},
	doi = {https://doi.org/10.1590/1678-9199-JVATITD-2023-0048},
	abstract = {The effect of peptide toxins on voltage-gated ion channels can be reliably assessed using electrophysiological assays, such as the patch-clamp technique. However, much of the toxinological research done in Central and South America aims at purifying and characterizing biochemical properties of the toxins of vegetal or animal origin, lacking electrophysiological approaches. This may happen due to technical and infrastructure limitations or because researchers are unfamiliar with the techniques and cellular models that can be used to gain information about the effect of a molecule on ion channels. Given the potential interest of many research groups in the highly biodiverse region of Central and South America, we reviewed the most relevant conceptual and methodological developments required to implement the evaluation of the effect of peptide toxins on mammalian voltage-gated ion channels using patch-clamp. For that, we searched MEDLINE/PubMed and SciELO databases with different combinations of these descriptors: “electrophysiology”, “patch-clamp techniques”, “Ca2+ channels”, “K+ channels”, “cnidarian venoms”, “cone snail venoms”, “scorpion venoms”, “spider venoms”, “snake venoms”, “cardiac myocytes”, “dorsal root ganglia”, and summarized the literature as a scoping review. First, we present the basics and recent advances in mammalian voltage-gated ion channel’s structure and function and update the most important animal sources of channel-modulating toxins (e.g. cnidarian and cone snails, scorpions, spiders, and snakes), highlighting the properties of toxins electrophysiologically characterized in Central and South America. Finally, we describe the local experience in implementing the patch-clamp technique using two models of excitable cells, as well as the participation in characterizing new modulators of ion channels derived from the venom of a local spider, a toxins’ source less studied with electrophysiological techniques. Fostering the implementation of electrophysiological methods in more laboratories in the region will strengthen our capabilities in many fields, such as toxinology, toxicology, pharmacology, natural products, biophysics, biomedicine, and bioengineering.Keywords: Patch-clamp techniques; Cellular model; Excitable cell; Venoms; Ionic current; Calcium channels; Potassium channels},
	language = {en},
	urldate = {2025-02-13},
	journal = {Journal of Venomous Animals and Toxins including Tropical Diseases},
	author = {Rojas-Palomino, Jessica and Gómez-Restrepo, Alejandro and Salinas-Restrepo, Cristian and Segura, César and Giraldo, Marco A. and Calderón, Juan C.},
	month = sep,
	year = {2024},
	note = {Publisher: Centro de Estudos de Venenos e Animais Peçonhentos (CEVAP/UNESP)},
	keywords = {Calcium channels, Cellular model, Excitable cell, Ionic current, Patch-clamp techniques, Potassium channels, Venoms},
	pages = {e20230048},
}

